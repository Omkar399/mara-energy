### Extended Pricing API Mock
```python
def generate_multi_site_pricing():
    """Generate site-specific pricing based on location, timezone, and local conditions"""
    base_mara_prices = get_mara_prices()  # Original MARA API call
    
    multi_site_prices = {}
    for site_id, site_config in MULTI_SITE_CONFIGURATION.items():
        # Adjust base prices based on site-specific factors
        local_time = get_local_time(site_config["location"]["timezone"])
        demand_multiplier = calculate_demand_multiplier(local_time)  # Higher during business hours
        
        multi_site_prices[site_id] = {
            "energy_price": base_mara_prices["energy_price"] * site_config["energy_cost_multiplier"],
            "hash_price": base_mara_prices["hash_price"] * demand_multiplier,
            "token_price": base_mara_prices["token_price"] * demand_multiplier,
            "cooling_factor": site_config["climate"]["cooling_efficiency"],
            "local_time": local_time,
            "timestamp": base_mara_prices["timestamp"]
        }
    
    return multi_site_prices
```

### Extended Inventory API Mock
```python
def generate_multi_site_inventory():
    """Extend MARA inventory to 10 sites with different hardware profiles"""
    base_inventory = get_mara_inventory()  # Original MARA API call
    
    multi_site_inventory = {}
    for site_id, site_config in MULTI_SITE_CONFIGURATION.items():
        gpu_ratio = site_config["hardware_profile"]["gpu_ratio"]
        asic_ratio = site_config["hardware_profile"]["asic_ratio"]
        
        # Scale inventory based on hardware profile
        multi_site_inventory[site_id] = {
            "inference": {
                "gpu": {
                    "power": base_inventory["inference"]["gpu"]["power"],
                    "tokens": base_inventory["inference"]["gpu"]["tokens"],
                    "available_capacity": int(site_config["power_capacity"] * gpu_ratio * 0.3)
                },
                "asic": {
                    "power": base_inventory["inference"]["asic"]["power"],
                    "tokens": base_inventory["inference"]["asic"]["tokens"],
                    "available_capacity": int(site_config["power_capacity"] * asic_ratio * 0.4)
                }
            },
            "miners": {
                "air": {
                    "hashrate": base_inventory["miners"]["air"]["hashrate"],
                    "power": base_inventory["miners"]["air"]["power"],
                    "available_capacity": int(site_config["power_capacity"] * 0.1)
                },
                "hydro": {
                    "hashrate": base_inventory["miners"]["hydro"]["hashrate"],
                    "power": base_inventory["miners"]["hydro"]["power"],
                    "available_capacity": int(site_config["power_capacity"] * 0.1)
                },
                "immersion": {
                    "hashrate": base_inventory["miners"]["immersion"]["hashrate"],
                    "power": base_inventory["miners"]["immersion"]["power"],
                    "available_capacity": int(site_config["power_capacity"] * 0.1)
                }
            },
            "site_config": site_config
        }
    
    return multi_site_inventory
```

